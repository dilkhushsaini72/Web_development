<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit your chats</title>
  </head>
  <body>
    <h2>Here you can edit your chats..</h2>
    <p>
      This message is send by <b> <%= chat.from %></b> to <b><%= chat.to %></b>
    </p>
    <form method="post" action="/chats/<%= chat.id %>/?_method=PUT">
      <textarea name="msg"><%= chat.msg %></textarea><br /><br />
      <button>Edit</button>
    </form>
  </body>
</html>
