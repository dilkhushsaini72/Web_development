<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit task in todo app</title>
  </head>
  <body>
    <h2>Edit your task Here</h2>
    <form method="post" action="/todo/<%= todo.id %>?_method=PUT">
      <input value="<%= todo.task %>" name="task" type="text" />
      <input type="submit" value="Edit" />
    </form>
  </body>
</html>
